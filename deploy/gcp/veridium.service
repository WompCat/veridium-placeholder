[Unit]
Description=Veridium web app
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/veridium

[Service]
User=veridium
Group=veridium
WorkingDirectory=/opt/veridium/veridium-pipeline
EnvironmentFile=/etc/veridium/veridium.env
ExecStart=/opt/veridium/veridium-pipeline/node_modules/.bin/tsx src/server.ts
# Back up within seconds after a crash; started at boot via WantedBy below.
Restart=always
RestartSec=3
# Listens on 127.0.0.1:3000 (from the env file); Caddy handles ports 80/443. No privileges needed.
CapabilityBoundingSet=
NoNewPrivileges=true
# The app only writes its database (and tsx's cache in a private /tmp).
ProtectSystem=strict
ReadWritePaths=/var/lib/veridium
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

# Riot developer key from https://developer.riotgames.com (dev keys expire every 24h)
RIOT_API_KEY=
# Local server port (default 4000)
PORT=
# Path to the sqlite cache file (default ./data/veridium.db)
DB_PATH=
# Seasons (TFT sets) of match history to load: the current one plus previous ones (default 3)
SEASONS=
# Interface to bind (default 0.0.0.0, so a host can route outside traffic in)
HOST=
# If set, the whole site asks for this password (any username). Recommended once deployed.
SITE_PASSWORD=
